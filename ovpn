#!/usr/bin/env bash
#
# ovpn - one name for the three scripts in this repo, and one idea on top of
# them: the folder you are standing in is the folder you meant.
#
#     cd ~/ovpn-pin/success
#     ovpn connect uk
#
# connects to a config in success/, not in pinned/. Nothing else in the repo
# works that way - ovpn-connect.sh reads one folder, decided by OVPN_OUT_DIR
# and defaulting to pinned/ - and that is deliberate: a script that quietly
# acts on wherever you happen to be is a bad script. A command you typed the
# name of, standing in a folder full of .ovpn files, is a different case. So
# the convenience lives here, in the wrapper, and the scripts stay literal.
#
# Install it with `./ovpn install`, which drops a symlink in ~/.local/bin.

set -uo pipefail

# Through the symlink, not from it. ~/.local/bin/ovpn is where this gets run
# from; dirname of that is ~/.local/bin, which is not where ovpn-connect.sh
# lives. readlink -f follows the link back to the repo.
SELF_PATH=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null)
[ -n "$SELF_PATH" ] || SELF_PATH=${BASH_SOURCE[0]}
ROOT=$(cd -- "$(dirname -- "$SELF_PATH")" && pwd)

CON=$ROOT/ovpn-connect.sh
PIN=$ROOT/resolve-ovpn-remote.sh
MENU=$ROOT/run.sh

if [ -t 1 ]; then
    C_OFF=$'\033[0m'; C_CYAN=$'\033[36m'; C_GRAY=$'\033[90m'
    C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
else
    C_OFF=''; C_CYAN=''; C_GRAY=''; C_RED=''; C_GREEN=''; C_YELLOW=''
fi

note() { printf '  %s%s%s\n' "$C_GRAY" "$*" "$C_OFF"; }
ok()   { printf '  %s[ ok ]%s %s\n' "$C_GREEN" "$C_OFF" "$*"; }
warn() { printf '  %s[warn]%s %s\n' "$C_YELLOW" "$C_OFF" "$*"; }
die()  { printf '\n  %s[fail]%s %s\n\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

for f in "$CON" "$PIN" "$MENU"; do
    [ -f "$f" ] || die "$(basename -- "$f") is missing from $ROOT.
         The symlink points at a copy of the repo that has moved or been
         deleted. Re-run ./ovpn install from wherever the repo is now."
done

# --------------------------------------------------------------- the folder

# Everything below decides one thing: whether to set OVPN_OUT_DIR to $PWD.
#
# It says no far more often than yes, because getting this wrong means acting
# on a folder the user did not mean, and the failure would be silent - a sweep
# of the wrong twenty configs looks exactly like a sweep of the right twenty.
#
# Answers it without acting on it, so that `ovpn where` can ask the same
# question `ovpn connect` does and get the same answer. Two copies of this
# would drift, and the whole value of `where` is that it tells you what the
# other commands are about to do.
#
# Prints the folder, or fails if $PWD is not one.
cwd_folder() {
    local f

    # Anything explicit outranks standing somewhere. If OVPN_OUT_DIR is
    # already set, or the command line names a folder itself, that is an
    # answer and this has no business overriding it.
    [ -n "${OVPN_OUT_DIR:-}" ] && return 1
    case " $* " in
        *' --retest '*|*' --success-dir '*|*' --sitetest-dir '*) return 1 ;;
    esac

    # The repo root holds scripts, not configs. Running `ovpn connect` from
    # there means pinned/, which is what the script does by itself.
    [ "$PWD" = "$ROOT" ] && return 1

    # A folder with no .ovpn in it is not a config folder, and pretending it
    # is would turn `ovpn stop` typed in your home directory into an error
    # about there being no configs there.
    for f in "$PWD"/*.ovpn; do
        [ -e "$f" ] || return 1
        break
    done

    printf '%s' "$PWD"
}

# configs/ holds the downloaded originals - the ones that still point at a
# hostname. Connecting to those is precisely what this repo exists to avoid,
# so it is worth saying rather than letting it fail puzzlingly later.
warn_if_originals() {
    [ "$1" = "$ROOT/configs" ] || return 0
    warn 'these are the downloaded originals - they still name a hostname,'
    note '       which is the thing your resolver lies about. Pin them first:'
    note '            ovpn pin'
    printf '\n'
}

use_cwd() {
    local here
    here=$(cwd_folder "$@") || return 0
    warn_if_originals "$here"
    export OVPN_OUT_DIR=$here
    note "folder: $here  ($(count_configs "$here") configs)"
}

count_configs() {
    local d=$1 f n=0
    for f in "$d"/*.ovpn; do [ -e "$f" ] && n=$((n + 1)); done
    printf '%s' "$n"
}

# ------------------------------------------------------------------ install

# Debian and Ubuntu ship a ~/.profile that adds ~/.local/bin to the PATH *if
# the folder exists*. Two things about that are easy to get wrong, and the
# first version of this got both:
#
#   - the test runs at login. If the folder did not exist then - and until
#     `ovpn install` ran, it did not - the line does nothing, and no amount of
#     opening new terminals re-runs it. It takes a logout.
#   - ~/.profile is for login shells. A new terminal window is an interactive
#     non-login shell: it reads ~/.bashrc and never looks at ~/.profile at all.
#
# So "your ~/.profile already handles it" is true and useless. The rc file is
# what a new terminal actually reads, so that is where the line goes.
add_to_path() {
    local bindir=$1 rc line
    line="export PATH=\"$bindir:\$PATH\""

    case ${SHELL##*/} in
        zsh)  rc=$HOME/.zshrc ;;
        bash) rc=$HOME/.bashrc ;;
        *)    rc='' ;;
    esac

    if [ -z "$rc" ]; then
        printf '\n'
        warn "$bindir is not on your PATH."
        note "       Your shell is ${SHELL##*/}, so add this wherever it keeps its PATH:"
        note "            $line"
        return 0
    fi

    if [ -f "$rc" ] && grep -qsF "$bindir" "$rc"; then
        note "$rc already adds $bindir"
        note 'so a new terminal will find it. This one will not - for that:'
        note "     $line"
        return 0
    fi

    { printf '\n# added by ovpn install\n%s\n' "$line" >> "$rc"; } 2>/dev/null || {
        printf '\n'
        warn "could not write $rc. Add this line to it yourself:"
        note "            $line"
        return 0
    }

    printf '\n'
    ok "added $bindir to your PATH in $rc"
    note 'Every new terminal will find it. This one already started, so for'
    note 'the shell you are in now:'
    printf '\n'
    note "     $line"
    printf '\n'
    note "Undo by deleting that line from $rc."
}

do_install() {
    local bindir=${1:-$HOME/.local/bin} link

    mkdir -p -- "$bindir" || die "cannot create $bindir"
    link=$bindir/ovpn

    if [ -e "$link" ] && [ ! -L "$link" ]; then
        die "$link exists and is not a symlink. Move it out of the way first."
    fi
    ln -sfn -- "$SELF_PATH" "$link" || die "cannot write $link"

    # The executable bit does not survive a zip, and a tree cloned on Windows
    # never had one to record. Everything here is run through `bash` anyway,
    # so this is only so that ./ovpn-connect.sh keeps working by hand.
    chmod +x -- "$SELF_PATH" "$CON" "$PIN" "$MENU" 2>/dev/null || true

    printf '\n'
    ok "$link  ->  $SELF_PATH"

    case ":$PATH:" in
        *":$bindir:"*) note "$bindir is on your PATH - type: ovpn" ;;
        *)             add_to_path "$bindir" ;;
    esac
    printf '\n'
    note 'Then, from anywhere:'
    note '     ovpn                     the menu'
    note '     ovpn connect uk-lon      connect, by part of a name'
    note '     ovpn sweep --one-per     test one address per location'
    note '     ovpn status              what is up'
    note '     ovpn stop                put everything back'
    printf '\n'
    note 'And the reason it is worth having on the PATH:'
    note '     cd success && ovpn connect uk'
    note 'acts on success/, because that is where you were standing.'
    printf '\n'
}

do_uninstall() {
    local bindir=${1:-$HOME/.local/bin} link
    link=$bindir/ovpn
    printf '\n'
    if [ -L "$link" ]; then
        rm -f -- "$link" && ok "removed $link"
    else
        note "nothing to remove at $link"
    fi
    note 'The repo itself is untouched.'
    printf '\n'
}

# --------------------------------------------------------------------- help

usage() {
    cat <<EOF

  ${C_CYAN}ovpn${C_OFF} - pin OpenVPN configs to real addresses, connect to them, and find
         out which of them the web will actually serve.

  ${C_GRAY}Standing in a folder that has .ovpn files in it makes that the folder
  every command below acts on. Otherwise pinned/. It says which one it
  chose before anything happens - \`ovpn help folders\` for the rules.${C_OFF}

  ${C_CYAN}Connecting${C_OFF}

    ovpn
        The menu. Every item prints the command your answers came to before
        running it, so it is a way of learning the flags rather than hiding them.

    ovpn connect [name]
        A number from the list, a whole filename, or enough of one to be
        unambiguous - \`ovpn connect uk-lon\`. Ambiguous is refused, not guessed.
        No name at all lists what is there, with the last sweep's verdict beside
        each. Probes the address first and only reaches for the proxy if it has
        to, then switches the system proxy off once the tunnel is up.

    ovpn <name>
        Same thing. Any word that is not a command below is taken as a config
        name, so \`ovpn uk-lon\` is the short form.

    ovpn switch <name>
        Bring down what is up, wait for its routes to go with it, then connect
        that one. Not the same as stop-then-connect typed quickly.

    ovpn stop
        Tunnel down, system proxy back to what it was, kill switch removed.

    ovpn status
        What is up, which device it is on, and - by asking Cloudflare - where
        your traffic is actually leaving from. That last part is the one your
        own machine cannot tell you.

  ${C_CYAN}Finding out which exits are any good${C_OFF}

    ovpn sweep [name]
        Connect to each config in turn, ask Cloudflare what it makes of that
        exit, drop it, next. Half a minute each. What comes up is copied into
        success/ with the handshake time in the name, so that folder sorted by
        name is "what to reach for when a tunnel drops". Narrow it:

          --one-per                     one address per location   (~140)
          --one-per-landlord            one per hosting company    (~20, start here)
          --one-per-landlord-location   one per company per location
          --landlord M247,Datacamp      only those companies
          --pick-landlord               list the companies, choose by number
          --retest                      sweep success/ instead of pinned/
          --site a.com,b.com            also test those hosts on every exit
          --first N                     stop after N
          --pick                        connect the best one when it is done

        Out of each group it takes whichever address connected quickest last
        time, read off the names in success/.

    ovpn check
        Judge the exit you are on this second. Connects to nothing. Cloudflare
        rules are per-customer, so a strict site can refuse an exit that
        Cloudflare's own pages serve happily - \`--site\` names extra ones.

    ovpn dns-check
        Is DNS going through the tunnel, or still being answered by your ISP?
        A poisoned answer reaches you through a perfectly good tunnel.

    ovpn who
        Name the hosting company behind each address - M247, Datacamp,
        Clouvider - and group them by it. Connects to nothing. One company is
        near enough one address as far as being blocked goes.

  ${C_CYAN}Pinning${C_OFF}

    ovpn pin
        Read every file in configs/, look each hostname up over DNS-over-HTTPS,
        and write copies into pinned/ with the real address written in. The
        originals are never touched. Start here.

    ovpn sync
        Re-resolve the hostnames behind what is already pinned. Providers move
        addresses; a pinned file cannot follow them.

  ${C_CYAN}Housekeeping${C_OFF}

    ovpn install [dir]     symlink this into ~/.local/bin, or dir
    ovpn uninstall [dir]   remove that symlink. The repo is untouched
    ovpn where             which repo this name points at, and which folder
                           it would act on if you ran something now
    ovpn version

  ${C_CYAN}More${C_OFF}

    ovpn help folders      the folder rules, and which ones get written to
    ovpn help connect      every flag ovpn-connect.sh takes
    ovpn help pin          every flag resolve-ovpn-remote.sh takes

  Flags are passed straight through, so anything in those two lists works here:

      cd success && ovpn sweep --one-per --landlord M247 --site example.com

EOF
}

help_folders() {
    cat <<EOF

  ${C_CYAN}Which folder ovpn acts on${C_OFF}

  If the directory you are standing in has .ovpn files in it, that is the one.
  Otherwise pinned/. Either way it says so on one line before anything runs:

      folder: /home/you/ovpn-pin/success  (528 configs)

  It declines more often than it accepts, because acting on a folder you did
  not mean fails silently - a sweep of the wrong twenty configs looks exactly
  like a sweep of the right twenty. It stays out of it when:

    - OVPN_OUT_DIR is already set in your shell. You said it; it stands.
    - the command line carries --retest, --success-dir or --sitetest-dir.
      Same reason.
    - you are in the repo root. That holds scripts, not configs.
    - the folder has no .ovpn in it. Otherwise \`ovpn stop\` typed at home
      would fail complaining there are no configs in your home directory.

  configs/ it will use, with a warning: those are the files you downloaded,
  and they still name a hostname - which is the thing your resolver lies
  about, and the reason this repo exists. Pin them first.

  ${C_CYAN}Which folders get written to${C_OFF}

  A sweep only ever reads the folder you point it at. What it writes, it
  writes to these, wherever it was pointed:

      success/                    everything that connected, time in the name
      success/landlord/           the quickest per company, per country
      success/landlord/fastest/   the quickest per company, anywhere
      sitetest/<host>/            what actually served that --site host

  So sweeping configs/ cannot damage configs/. It is merely pointless, for the
  hostname reason above.

  ${C_CYAN}The two folders worth knowing about${C_OFF}

  Point a sweep at success/ and it becomes a re-test: anything that has stopped
  connecting is dropped from it, because a folder that says these all work
  should not be quietly wrong. It says so before it starts. Every deletion
  there is keyed on a config's own name, so nothing else is touched.

  The landlord folders are the exception. They keep one entry per *company*,
  so their deletions are keyed on a tag that several different configs share:
  sweep one of them and the first M247 to come up deletes the other M247 files,
  including ones still queued in that same sweep. Those are skipped and named
  rather than reported as broken, and the sweep warns you at the start - but
  the question is better asked as

      ovpn sweep --retest --one-per-landlord

  which tests one address per company out of success/ and prunes nothing.

EOF
}

do_where() {
    printf '\n'
    note "repo   : $ROOT"
    note "command: $SELF_PATH"
    note "here   : $PWD"
    local here
    if [ -n "${OVPN_OUT_DIR:-}" ]; then
        note "folder : $OVPN_OUT_DIR  ($(count_configs "$OVPN_OUT_DIR") configs, from OVPN_OUT_DIR in your shell)"
        printf '\n'
    elif here=$(cwd_folder); then
        note "folder : $here  ($(count_configs "$here") configs, because you are standing in it)"
        printf '\n'
        warn_if_originals "$here"
    else
        note "folder : $ROOT/pinned  ($(count_configs "$ROOT/pinned") configs, the default)"
        printf '\n'
    fi
}

# ----------------------------------------------------------------- dispatch

# Through `bash` rather than on the executable bit, for the same reason run.sh
# does it: a tree that arrived by zip, or was cloned on Windows, has no such
# bit, and "Permission denied" says nothing about which of those happened.
con()  { use_cwd "$@"; exec bash "$CON" "$@"; }
pin()  { exec bash "$PIN" "$@"; }

cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
    ''|menu)              exec bash "$MENU" "$@" ;;

    connect|c)            con "$@" ;;
    switch)               [ $# -gt 0 ] || die 'switch needs a config name: ovpn switch uk-lon'
                          con --switch "$@" ;;
    sweep|s)              con --sweep "$@" ;;
    stop)                 con --stop "$@" ;;
    status|st)            con --status "$@" ;;
    dns-check|dnscheck)   con --dns-check "$@" ;;
    unlock)               con --kill-switch-off "$@" ;;
    service)              con --install-service "$@" ;;

    pin|p)                pin "$@" ;;
    sync)                 pin --sync "$@" ;;
    who)                  pin --who "$@" ;;
    check|cf)             pin --check-cloudflare "$@" ;;

    install)              do_install "$@" ;;
    uninstall)            do_uninstall "$@" ;;
    where)                do_where ;;

    version|-V|--version) exec bash "$CON" --version ;;
    help|-h|--help)
        case ${1:-} in
            folders|folder|where)          help_folders ;;
            connect|sweep|stop|status|switch|dns-check|c|s) exec bash "$CON" --help ;;
            pin|sync|who|check|p)          exec bash "$PIN" --help ;;
            '')                            usage ;;
            *) die "no help for '$1'. Try one of:
         ovpn help            every command, and what it does
         ovpn help folders    which folder it acts on, and what gets written
         ovpn help connect    every flag ovpn-connect.sh takes
         ovpn help pin        every flag resolve-ovpn-remote.sh takes" ;;
        esac ;;

    # Not a subcommand. Either a flag, which belongs to ovpn-connect.sh, or a
    # config name - `ovpn uk-lon` being the short way to say connect.
    *)                    con "$cmd" "$@" ;;
esac
