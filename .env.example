# Copy this to .env and fill it in.  The Linux script reads it, writes the
# credentials to an auth file of its own (mode 600), and points every pinned
# config at that file - so the OpenVPN client stops asking for a username and
# password on every connect.
#
#     cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Keep it that way.

OVPN_USER=
OVPN_PASS=


# ---------------------------------------------------------------- optional --
# Defaults for the command line flags. Anything set here is overridden by the
# matching flag, and by the same variable exported in your shell.
#
# The first group is for ovpn-connect.sh - connecting, and getting the proxy
# out of the way once the tunnel is up.

# Run something of your own after the tunnel comes up, and its opposite after
# it goes down. ovpn-connect.sh already switches the GNOME system proxy off
# and back on by itself; these are for whatever else your setup needs.
#     OVPN_PROXY_OFF_CMD='gsettings set org.gnome.system.proxy mode none'
#     OVPN_PROXY_OFF_CMD='systemctl --user stop v2raya'
#OVPN_PROXY_OFF_CMD=
#OVPN_PROXY_ON_CMD=

# Only used when a tunnel has to be dialled *through* the proxy, which happens
# when the pinned address itself is blocked and not just its DNS. That tunnel
# is carried by the proxy's own connection, so that connection must keep going
# out the physical interface rather than into the tunnel it carries - which
# means a direct route for the address your proxy client talks to. It is
# worked out from `ss` when it can be; name it here when it cannot.
#OVPN_PROXY_UPSTREAM=

# What to do when the pinned address does not answer directly:
#   ask   offer the three below (the default on a terminal)
#   proxy dial through the proxy, which then stays up for the whole session
#   next  try the other pinned files, take the first that answers directly
#   stop  connect nothing and list what does answer
#OVPN_FALLBACK=ask

# Whether the tunnel itself goes through the proxy:
#   auto   probe first, use the proxy only if the address cannot be dialled
#   direct never; fail instead
#   proxy  always
#OVPN_CONNECT_VIA=auto

# And whether the DoH lookups do. 'proxy' skips the direct attempt, which is
# twenty seconds a run on a line where DoH is blocked outright.
#OVPN_DOH_VIA=auto

# Block everything that is not the tunnel while it is up, so a drop cannot
# leak your real address. Needs nftables. Removed by --stop.
#OVPN_KILL_SWITCH=0

# Point the tunnel interface at the DNS the server pushes (systemd-resolved).
# Without it the system resolver stays as it was - which on a poisoned line
# means forged answers arriving through a perfectly good tunnel.
#OVPN_SET_DNS=0

# Where the auth file is written. Absolute, or relative to the repo.
#OVPN_AUTH_FILE=.ovpn-auth

# Add an auth-user-pass line to configs that have none. Off by default: a
# cert-only server handed a username can refuse the connection outright.
#OVPN_ADD_AUTH=0

# HTTP proxy for the DoH lookups. Omitted, DoH is tried directly first and a
# local proxy is looked for only if that fails.
#OVPN_PROXY=http://127.0.0.1:10808

# cloudflare (default) or google
#OVPN_RESOLVER=cloudflare

# Cap on how many files to write per input config.
#OVPN_MAX_IPS=4

# Where the downloaded configs live, and where the pinned copies go.
#OVPN_CONFIG_DIR=configs
#OVPN_OUT_DIR=pinned

# Extra hosts for --check-cloudflare, comma separated.
#OVPN_SITE=chatgpt.com,github.com
